{
  "name": "anna-syntax",
  "displayName": "ANNA Syntax Highlighting",
  "description": "Syntax highlighting support for the ANNA assembly language used in CPSC 2500.",
  "version": "0.0.1",
  "publisher": "jacob",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "anna",
        "aliases": ["ANNA", "anna"],
        "extensions": [".anna", ".ac"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "anna",
        "scopeName": "source.anna",
        "path": "./syntaxes/anna.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "anna",
        "path": "./snippets/anna.json"
      }
    ]
  }
}
